FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PLAYWRIGHT_BROWSERS_PATH=/ms-playwright ATF_PUBLIC_DEMO=1 ATF_DATA_DIR=/tmp/sandbox-data
WORKDIR /app
COPY requirements-demo.txt .
RUN pip install --no-cache-dir -r requirements-demo.txt && python -m playwright install --with-deps chromium && chmod -R a+rX /ms-playwright
COPY . .
RUN useradd --create-home --uid 1000 sandbox && chown -R sandbox:sandbox /app
USER sandbox
EXPOSE 10000
CMD ["sh", "-c", "uvicorn cloud_app:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1 --proxy-headers"]

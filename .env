# Database
DATABASE_URL=postgresql://judge:judgepass@postgres:5432/judgedb
POSTGRES_USER=judge
POSTGRES_PASSWORD=judgepass
POSTGRES_DB=judgedb

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Docker Socket Proxy — worker connects here, NOT to /var/run/docker.sock directly
DOCKER_HOST=tcp://docker-socket-proxy:2375

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder

# Sandbox
SANDBOX_TIMEOUT=5
SANDBOX_BASE_DIR=/tmp/judge_sandboxes
